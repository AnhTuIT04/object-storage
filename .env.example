# Cloudflare R2 S3-compatible API credentials (required)
# Create tokens at: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2 ignores the region; use "auto"
AWS_REGION=auto

# R2 requires path-style addressing -> set to true
AWS_S3_FORCE_PATH_STYLE=true

# Optional: base URL used to build the public `url` returned after an upload.
# Set this to your R2 public bucket URL (e.g. https://pub-<account-id>.r2.dev)
# if you've enabled public access on the bucket. If unset, the SDK's Location
# header is used instead.
OBJECT_ACCESS_URL=https://pub-<account-id>.r2.dev

# Server configuration
PORT=5000
NODE_ENV=development
